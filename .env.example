# Copy to .env and edit. Every value here is optional: with no .env at all the
# service runs with the defaults in configs/config.yaml, an in-process cache and
# ephemeral deployment state.
#
# This file did not exist, while README's quickstart step 1 said `cp .env.example
# .env` and .gitignore carried a `!.env.example` un-ignore rule for it. The first
# command in the quickstart could not be run.

# ---- Online cache -----------------------------------------------------------
# Empty means "there is no Redis here" -- the service uses its in-process cache
# and reports cache_backend="in_process" on /health. Set a host to use Redis.
REDIS_HOST=
REDIS_PORT=6379

# ---- Deployment state -------------------------------------------------------
# 1 keeps canary/shadow state in memory only, which is what tests and ephemeral
# containers want. Unset or 0 persists it to disk so a restart resumes mid-canary.
EPHEMERAL_STATE=1

# ---- Server -----------------------------------------------------------------
# The port uvicorn binds. Cloud Run and most PaaS hosts inject this themselves.
PORT=8080

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=*
